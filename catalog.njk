---
title: Catalog
layout: base.njk
---

<p id="catalogFilterNotice" class="catalog-filter-notice" style="display:none;">
  Showing: <strong id="catalogFilterName"></strong>
  &mdash; <a href="{{ '/catalog/' | relativeUrl(page.url) }}">Clear filter</a>
</p>

<div class="catalog-grid">
  {% for item in products %}
    {% if item.active and item.id and item.name %}
    <div
      class="product-card product-card-clickable"
      data-href="{{ ('/products/' + item.id + '/') | relativeUrl(page.url) }}"
      data-category="{{ item.category }}"
      tabindex="0"
      role="link"
      aria-label="View {{ item.name }}"
    >
      <div class="image-cycler">
        {% if item.images %}
          {% for img in item.images %}
            <img src="{{ img | relativeUrl(page.url) }}"
            alt="{{ item.name }}"
            class="{{ 'active' if loop.first }}"
            loading="eager"
            {% if loop.first %}fetchpriority="high"{% endif %}>
          {% endfor %}
        {% elif item.image %}
          <img src="{{ item.image | relativeUrl(page.url) }}" alt="{{ item.name }}">
        {% endif %}
      </div>

      <h2>{{ item.name }}</h2>
      <p class="category">{{ item.category }}</p>
      <p>{{ item.description }}</p>

      {% if item.price %}
        <p class="price">{{ item.price }}</p>
      {% endif %}

      <a
        href="https://wa.me/{{ site.whatsappNumber }}?text=Hi!%20I'm%20interested%20in%20the%20{{ item.name | urlencode }}"
        class="btn-buy"
      >
        Buy
      </a>

      <a
        href="https://wa.me/{{ site.whatsappNumber }}?text=Hi!%20Can%20you%20tell%20me%20more%20about%20the%20{{ item.name | urlencode }}"
        class="btn-info"
      >
        Find out more
      </a>
    </div>
    {% endif %}
  {% endfor %}
</div>

<script>
  document.querySelectorAll(".product-card-clickable").forEach((card) => {
    card.addEventListener("click", (event) => {
      if (event.target.closest("a")) return;
      window.location.href = card.dataset.href;
    });

    card.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        if (event.target.closest("a")) return;
        event.preventDefault();
        window.location.href = card.dataset.href;
      }
    });
  });

  (function filterByCategory() {
    const params = new URLSearchParams(window.location.search);
    const filterCat = params.get("cat");
    if (!filterCat) return;

    const normalizedFilter = filterCat.trim().toLowerCase();
    let matchCount = 0;

    document.querySelectorAll(".product-card").forEach((card) => {
      const cardCat = (card.dataset.category || "").trim().toLowerCase();
      if (cardCat !== normalizedFilter) {
        card.style.display = "none";
      } else {
        matchCount += 1;
      }
    });

    const notice = document.getElementById("catalogFilterNotice");
    const nameEl = document.getElementById("catalogFilterName");
    if (notice && nameEl) {
      nameEl.textContent = filterCat;
      notice.style.display = "block";
    }
  })();
</script>
